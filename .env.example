OPENAI_API_KEY=replace-with-your-api-key
# Optional cost-aware default used by TripSync:
OPENAI_MODEL=gpt-5.6-luna

# Optional shared persistence. Both values are required together.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-server-side-secret

# Required to open the Feedback insights admin workspace.
TRIPSYNC_ADMIN_PASSWORD=choose-a-strong-password
